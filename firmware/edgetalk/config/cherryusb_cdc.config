# H-ball EdgeTalk M33 USB Device CDC probe fragment.
# Append to the BSP .config, then regenerate rtconfig.h or apply the matching
# rtconfig_cherryusb_cdc.h fragment in an isolated build tree.
CONFIG_RT_USING_CHERRYUSB=y
CONFIG_RT_CHERRYUSB_DEVICE=y
CONFIG_RT_CHERRYUSB_DEVICE_SPEED_FS=y
CONFIG_RT_CHERRYUSB_DEVICE_DWC2_INFINEON=y
CONFIG_RT_CHERRYUSB_DEVICE_CDC_ACM=y
CONFIG_RT_CHERRYUSB_DEVICE_CDC_ACM_CHARDEV=y
CONFIG_RT_CHERRYUSB_DEVICE_TEMPLATE_NONE=y
